
int TotalTestCount;

#ifnver 3.6.2
String GetEngineVersionFromRuntimeInfo()
{
  String rt_info = System.RuntimeInfo;
  int ver_at = rt_info.IndexOf("Engine version ");
  if (ver_at >= 0)
  {
    ver_at += 15;
    rt_info = rt_info.Substring(ver_at, rt_info.Length - ver_at);
    int ver_end_at = rt_info.IndexOf("\n");
    if (ver_end_at < 0)
    {
      ver_end_at = rt_info.IndexOf("[");
    }
    if (ver_end_at >= 0)
    {
      rt_info = rt_info.Substring(0, ver_end_at);
    }
    return rt_info;
  }
  return "unknown";
}
#endif

void BeginTests()
{
  int test_count = 0;
  // Stage 1 tests
  test_count += GetTestAudioCount();
  test_count += GetTestCharactersCount();
  test_count += GetTestCharacterMoveCount();
  test_count += GetTestDialogPropertiesCount();
  test_count += GetTestDictionaryCount();
  test_count += GetTestDrawingSurfaceCount();
  test_count += GetTestEngineRenderCount();
  test_count += GetTestFileCount();
  test_count += GetTestFileDirectoryCount();
  test_count += GetTestGUIPropertiesCount();
  test_count += GetTestGUILooksCount();
  test_count += GetTestHotspotsCount();
  test_count += GetTestMathsCount();
  test_count += GetTestMiscCount();
  test_count += GetTestObjectAccessCount();
  test_count += GetTestObjectsCount();
  test_count += GetTestOverlaysCount();
  test_count += GetTestParserCount();
  test_count += GetTestRegionsCount();
  test_count += GetTestStringCount();
  test_count += GetTestSetCount();
  test_count += GetTestTimersCount();
  // Stage 1 delayed tests
  test_count += GetTestDialogAutoFlowCount();
  test_count += GetTestDialogCustomOptionsCount();
  test_count += GetTestGUILooksDelayedCount();
  test_count += GetTestInputControlsCount();
  test_count += GetTestInteractionsCount();
  test_count += GetTestSaveListCount();
  // Stage 2 tests
  test_count += GetTestPathfindingCount();
  
  TotalTestCount = test_count;
  
  // IMPORTANT: tap.plan() must be the first call prior to any other output, 
  // this is required by the tap results parser.
  tap.clean_test();
  tap.plan(test_count);
  
#ifver 3.6.2
  tap.Comment(String.Format("Running AGS engine %s", System.GetEngineString(ENGINE_VALUE_S_ENGINE_VERSION_FULL)));
#endif
#ifnver 3.6.2
  tap.Comment(String.Format("Running AGS engine %s", GetEngineVersionFromRuntimeInfo()));
#endif
}

void FinishTests()
{
  tap.done_testing();
  
  if (tap.AnyTestFailed()) {
    AbortGame("ERROR: test(s) have failed.");
  }
  
  if (tap.PlannedTests != tap.ExecutedTests) {
    AbortGame("ERROR: Plan mismatch! Planned %d tests, but ran %d tests.", tap.PlannedTests, tap.ExecutedTests);
  }
  
  QuitGame(0);
}

void RunStage1Tests()
{
  // Run utility tests first, because they are faster and dont depend on game objects
  TestDictionary();
  TestFile();
  TestFileDirectory();
  TestMaths();
  TestSet();
  TestString();
  
  // Other tests
  TestCharacters();
  TestCharacterMove();
  TestDrawingSurface();
  TestObjectAccess();
  TestDialogProperties();
  TestGUIProperties();
  TestGUILooks();
  TestHotspots();
  TestMisc();
  TestObjects();
  TestOverlays();
  TestParser();
  TestRegions();
  TestTimers();
  
  // Audio tests
  TestAudio();
  
  // Engine render tests
  TestEngineRender();
}

int RunStage1DelayedTests(int test_group, int test_counter)
{
  // Can add more different tests here, depending on "test_group" value.
  if (test_group == 0)
  {
    return TestInteractions(test_counter);
  }
  else if (test_group == 1)
  {
    return TestGUILooksDelayed(test_counter);
  }
  else if (test_group == 2)
  {
    return TestDialogCustomOptionsDelayed(test_counter);
  }
  else if (test_group == 3)
  {
    return TestSaveList(test_counter);
  }
  else if (test_group == 4)
  {
    return TestDialogAutoFlow(test_counter);
  }
  else if (test_group == 5)
  {
    return TestInputControls(test_counter);
  }
  else
  {
    return -1;
  }
}

void RunStage2Tests()
{
  TestPathfinding();
}
