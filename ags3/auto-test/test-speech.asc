// Test Speech Module Script
int GetTestSpeechCount()
{
  return 0
  + 8 // speech render
  ;
}

#define OVERLAY_TEXTUAL_COLOR_SB 65523

#define SPEECH_SHOT_LA_SAY            63
#define SPEECH_SHOT_LA_SAYAT          64
#define SPEECH_SHOT_SAYBACKGROUND     65
#define SPEECH_SHOT_SB_SAY            66
#define SPEECH_SHOT_SB_SAYAT          67

int TestNumber = -1;
int WaitForRedraw;
Overlay* SpeechOver;

function repeatedly_execute_always()
{
  if (TestNumber < 0)
    return;
    
  WaitForRedraw++;
  if (WaitForRedraw < 2)
    return;
  
  // TODO: hardcoded the speech positions for now, but ideally these should be precalculated, 
  // knowing engine's formulas and getting wrapped text width and height.
  // At the moment of writing the speech test sprites were made as minimal as possible,
  // but likely they have to be padded with extra black pixels around them, to match the actual
  // text overlay's bounds. Then the overlay positions can be determined properly.
  // 
  // The lucas-style speech position depends on the character's position (and speech view height).
  // The sierra-style speech position depends on the portrait's position (so speech view width).
  
  if (TestNumber == 0)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(60, 71, 200, 25, SPEECH_SHOT_LA_SAY), "Character.Say (LA): render");
  }
  else if (TestNumber == 1)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(105, 41, 90, 61, SPEECH_SHOT_LA_SAYAT), "Character.SayAt (LA): render");
  }
  else if (TestNumber == 2)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(115, 35, 90, 61, SPEECH_SHOT_LA_SAYAT), "Character.SayAt (LA, def pos): render");
  }
  else if (TestNumber == 3)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(85, 56, 150, 34, SPEECH_SHOT_SAYBACKGROUND), "Character.SayBackground (LA): render");
  }
  else if (TestNumber == 4)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(32, 20, 247, 41, SPEECH_SHOT_SB_SAY), "Character.Say (SB): render");
  }
  else if (TestNumber == 5)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(120, 46, 92, 104, SPEECH_SHOT_SB_SAYAT), "Character.SayAt (SB): render");
  }
  else if (TestNumber == 6)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(32, 20, 92, 104, SPEECH_SHOT_SB_SAYAT), "Character.SayAt (SB, def pos): render");
  }
  else if (TestNumber == 7)
  {
    tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(85, 56, 150, 34, SPEECH_SHOT_SAYBACKGROUND), "Character.SayBackground (SB): render");
  }
  
  WaitForRedraw = 0;
  if (SpeechOver != null)
  {
    SpeechOver.Remove();
    SpeechOver = null;
  }
  else if (player.Speaking)
  {
    Game.SimulateKeyPress(eKeySpace);
  }
}

void TestSpeech()
{
  TestHelpers.HideGUIs();
  TestHelpers.HideRoomObjects();
  player.on = true;
  
  String sayString = "This is a speech string. It is long enough to cause some text wrapping. We'd like to see how it wraps.";
  
  Speech.SkipStyle = eSkipKey;
  Speech.SkipKey = eKeySpace;
  Speech.Style = eSpeechLucasarts;
  player.SpeechView = VSPEAKING;
  
  player.x = 160;
  player.y = 100;
  TestNumber = 0;
  player.Say(sayString);
  TestNumber++;
  // SayAt: The way the text is aligned to the given position depends on the speech style:
  // Lucas-Arts style speech aligns by the left-bottom corner (upwards from the passed Y coordinate);
  player.SayAt(100, 100, 100, sayString);
  TestNumber++;
  // If a negative value is passed as either X or Y coordinate, the text will be instead set at the default position for the respective axis:
  // Lucas-Arts style speech by default is positioned above the speaking character's head; 
  player.SayAt(-1, -1, 100, sayString);
  TestNumber++;
  SpeechOver = player.SayBackground(sayString);
  Wait(2); // one wait to redraw, another to test and remove
  
  // TODO: eSpeechSierra (aka transparent, no background)
  
  Speech.Style = eSpeechSierraWithBackground;
  game.speech_text_gui = 2;
  gTextWindow1.AsTextWindow.TextColor = OVERLAY_TEXTUAL_COLOR_SB;
  gTextWindow1.AsTextWindow.BackgroundColor = 19248;
  gTextWindow1.AsTextWindow.TextPadding = 3;
  player.SpeechView = VPORTRAIT;
  
  TestNumber++;
  player.Say(sayString);
  TestNumber++;
  // SayAt: The way the text is aligned to the given position depends on the speech style:
  // Sierra style speech aligns by the left-top corner. 
  player.SayAt(100, 50, 100, sayString);
  TestNumber++;
  // If a negative value is passed as either X or Y coordinate, the text will be instead set at the default position for the respective axis:
  // Sierra style speech by default is positioned at the top of the screen, centered horizontally. 
  player.SayAt(-1, -1, 100, sayString);
  TestNumber++;
  // No need to test SayBackground in Sierra style, because it always works as a LA style overlay?
  SpeechOver = player.SayBackground(sayString);
  Wait(2); // one wait to redraw, another to test and remove
  
  // Cleanup
  TestNumber = -1;
  Speech.Style = eSpeechLucasarts;
  if (SpeechOver != null)
    SpeechOver.Remove();
  SpeechOver = null;
}
