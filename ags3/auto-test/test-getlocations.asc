// Test Get Locations Module Script
int GetTestGetLocationsCount()
{
  return 40
  ;
}

// Positions are in ROOM coordinates
#define CHAR1_POSITION 148, 57
#define CHAR2_POSITION 532, 253
#define CHAR1_HIT_POSX 148
#define CHAR1_HIT_POSY 57 - 10
#define CHAR2_HIT_POSX 532
#define CHAR2_HIT_POSY 253 - 10
#define OBJ1_HIT_POSX  117
#define OBJ1_HIT_POSY  98
#define OBJ2_HIT_POSX  537
#define OBJ2_HIT_POSY  292
#define HOT1_HIT_POSX  53
#define HOT1_HIT_POSY  39
#define HOT2_HIT_POSX  574
#define HOT2_HIT_POSY  356
#define REG1_HIT_POSX  29
#define REG1_HIT_POSY  98
#define REG2_HIT_POSX  624
#define REG2_HIT_POSY  293
#define WALK1_HIT_POSX 80
#define WALK1_HIT_POSY 135
#define WALK2_HIT_POSX 573
#define WALK2_HIT_POSY 292
#define WB1_HIT_POSX   19
#define WB1_HIT_POSY   19
#define WB2_HIT_POSX   626
#define WB2_HIT_POSY   381

void TestGetLocations()
{
  tap.Comment("start GetLocations tests");
  
  //------------------------------------------
  // Prepare
  //------------------------------------------
  player.x = -100;
  player.y = -100;
  cOne.ChangeRoom(player.Room, CHAR1_POSITION);
  cOne.ChangeView(VCHARHITTEST);
  cOne.on = true;
  cOne.Clickable = true;
  cTwo.ChangeRoom(player.Room, CHAR2_POSITION);
  cTwo.ChangeView(VCHARHITTEST);
  cTwo.on = true;
  cTwo.Clickable = true;
  
  TestHelpers.HideGUIs();
  
  Game.Camera.SetAt(0, 0);
  Game.Camera.SetSize(320, 200);
  Screen.Viewport.SetPosition(0, 0, 320, 200);
  Wait(1); // this is in case we need to update a camera
  
  //------------------------------------------
  // Run tests
  //------------------------------------------
  // Camera is at 0, 0
  tap.is_int(GetLocationType(100, 30), eLocationNothing, "GetLocationType: camera pos1, nothing");
  tap.is_int(GetLocationType(CHAR1_HIT_POSX, CHAR1_HIT_POSY), eLocationCharacter, "GetLocationType: camera pos1, character 1");
  tap.is_int(GetLocationType(OBJ1_HIT_POSX, OBJ1_HIT_POSY), eLocationObject, "GetLocationType: camera pos1, object 1");
  tap.is_int(GetLocationType(HOT1_HIT_POSX, HOT1_HIT_POSY), eLocationHotspot, "GetLocationType: camera pos1, hotspot 1");
  
  tap.is(Game.GetLocationName(100, 30), "", "GetLocationName: camera pos1, nothing");
  tap.is(Game.GetLocationName(CHAR1_HIT_POSX, CHAR1_HIT_POSY), "First new character", "GetLocationName: camera pos1, character 1");
  tap.is(Game.GetLocationName(OBJ1_HIT_POSX, OBJ1_HIT_POSY), "The first object", "GetLocationName: camera pos1, object 1");
  tap.is(Game.GetLocationName(HOT1_HIT_POSX, HOT1_HIT_POSY), "The first hotspot", "GetLocationName: camera pos1, hotspot 1");
  
  // room pos should not depend on camera
  Character* c = Character.GetAtRoomXY(CHAR1_HIT_POSX, CHAR1_HIT_POSY);
  tap.ok(c == cOne, "Character.GetAtRoomXY: camera pos1, character 1");
  c = Character.GetAtRoomXY(CHAR2_HIT_POSX, CHAR2_HIT_POSY);
  tap.ok(c == cTwo, "Character.GetAtRoomXY: camera pos1, character 2");
  Object* o = Object.GetAtRoomXY(OBJ1_HIT_POSX, OBJ1_HIT_POSY);
  tap.ok(o == object[0], "Object.GetAtRoomXY: camera pos1, object 1");
  o = Object.GetAtRoomXY(OBJ2_HIT_POSX, OBJ2_HIT_POSY);
  tap.ok(o == object[1], "Object.GetAtRoomXY: camera pos1, object 2");
  Hotspot* h = Hotspot.GetAtRoomXY(HOT1_HIT_POSX, HOT1_HIT_POSY);
  tap.ok(h == hotspot[1], "Hotspot.GetAtRoomXY: camera pos1, hotspot 1");
  h = Hotspot.GetAtRoomXY(HOT2_HIT_POSX, HOT2_HIT_POSY);
  tap.ok(h == hotspot[2], "Hotspot.GetAtRoomXY: camera pos1, hotspot 2");
  Region* r = Region.GetAtRoomXY(REG1_HIT_POSX, REG1_HIT_POSY);
  tap.ok(r == region[1], "Region.GetAtRoomXY: camera pos1, region 1");
  r = Region.GetAtRoomXY(REG2_HIT_POSX, REG2_HIT_POSY);
  tap.ok(r == region[2], "Region.GetAtRoomXY: camera pos1, region 2");
  
  // screen pos depends on camera
  c = Character.GetAtScreenXY(CHAR1_HIT_POSX, CHAR1_HIT_POSY);
  tap.ok(c == cOne, "Character.GetAtScreenXY: camera pos1, character 1");
  o = Object.GetAtScreenXY(OBJ1_HIT_POSX, OBJ1_HIT_POSY);
  tap.ok(o == object[0], "Object.GetAtScreenXY: camera pos1, object 1");
  h = Hotspot.GetAtScreenXY(HOT1_HIT_POSX, HOT1_HIT_POSY);
  tap.ok(h == hotspot[1], "Hotspot.GetAtScreenXY: camera pos1, hotspot 1");
  r = Region.GetAtScreenXY(REG1_HIT_POSX, REG1_HIT_POSY);
  tap.ok(r == region[1], "Region.GetAtScreenXY: camera pos1, region 1");
  
  // Camera is at 320, 200
  Game.Camera.SetAt(320, 200);
  
  tap.is_int(GetLocationType(100, 30), eLocationNothing, "GetLocationType: camera pos1, nothing");
  tap.is_int(GetLocationType(CHAR2_HIT_POSX - 320, CHAR2_HIT_POSY - 200), eLocationCharacter, "GetLocationType: camera pos2, character 2");
  tap.is_int(GetLocationType(OBJ2_HIT_POSX - 320, OBJ2_HIT_POSY - 200), eLocationObject, "GetLocationType: camera pos2, object 2");
  tap.is_int(GetLocationType(HOT2_HIT_POSX - 320, HOT2_HIT_POSY - 200), eLocationHotspot, "GetLocationType: camera pos2, hotspot 2");
  
  tap.is(Game.GetLocationName(100, 30), "", "GetLocationName: camera pos1, nothing");
  tap.is(Game.GetLocationName(CHAR2_HIT_POSX - 320, CHAR2_HIT_POSY - 200), "Second new character", "GetLocationName: camera pos2, character 2");
  tap.is(Game.GetLocationName(OBJ2_HIT_POSX - 320, OBJ2_HIT_POSY - 200), "The second object", "GetLocationName: camera pos2, object 2");
  tap.is(Game.GetLocationName(HOT2_HIT_POSX - 320, HOT2_HIT_POSY - 200), "The second hotspot", "GetLocationName: camera pos2, hotspot 2");
  
  // room pos should not depend on camera
  c = Character.GetAtRoomXY(CHAR1_HIT_POSX, CHAR1_HIT_POSY);
  tap.ok(c == cOne, "Character.GetAtRoomXY: camera pos2, character 1");
  c = Character.GetAtRoomXY(CHAR2_HIT_POSX, CHAR2_HIT_POSY);
  tap.ok(c == cTwo, "Character.GetAtRoomXY: camera pos2, character 2");
  o = Object.GetAtRoomXY(OBJ1_HIT_POSX, OBJ1_HIT_POSY);
  tap.ok(o == object[0], "Object.GetAtRoomXY: camera pos2, object 1");
  o = Object.GetAtRoomXY(OBJ2_HIT_POSX, OBJ2_HIT_POSY);
  tap.ok(o == object[1], "Object.GetAtRoomXY: camera pos2, object 2");
  h = Hotspot.GetAtRoomXY(HOT1_HIT_POSX, HOT1_HIT_POSY);
  tap.ok(h == hotspot[1], "Object.GetAtRoomXY: camera pos1, hotspot 1");
  h = Hotspot.GetAtRoomXY(HOT2_HIT_POSX, HOT2_HIT_POSY);
  tap.ok(h == hotspot[2], "Object.GetAtRoomXY: camera pos1, hotspot 2");
  r = Region.GetAtRoomXY(REG1_HIT_POSX, REG1_HIT_POSY);
  tap.ok(r == region[1], "Region.GetAtRoomXY: camera pos1, region 1");
  r = Region.GetAtRoomXY(REG2_HIT_POSX, REG2_HIT_POSY);
  tap.ok(r == region[2], "Region.GetAtRoomXY: camera pos1, region 2");
  
  // screen pos depends on camera
  c = Character.GetAtScreenXY(CHAR2_HIT_POSX - 320, CHAR2_HIT_POSY - 200);
  tap.ok(c == cTwo, "Character.GetAtScreenXY: camera pos2, character 2");
  o = Object.GetAtScreenXY(OBJ2_HIT_POSX - 320, OBJ2_HIT_POSY - 200);
  tap.ok(o == object[1], "Object.GetAtScreenXY: camera pos1, object 2");
  h = Hotspot.GetAtScreenXY(HOT2_HIT_POSX - 320, HOT2_HIT_POSY - 200);
  tap.ok(h == hotspot[2], "Hotspot.GetAtScreenXY: camera pos1, hotspot 2");
  r = Region.GetAtScreenXY(REG2_HIT_POSX - 320, REG2_HIT_POSY - 200);
  tap.ok(r == region[2], "Region.GetAtScreenXY: camera pos1, region 2");
  
  tap.Comment("end GetLocations tests");
}
