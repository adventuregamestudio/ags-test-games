// Test Camera Module Script
int GetTestCameraCount()
{
  return 0
  + 29 // render tests
  ;
}

// We draw upon this sprite, draw the sprite onto the room, 
// then make screenshots of a room viewport and compare with respective portions of this sprite
DynamicSprite *TestSpr;

void PrepareRoom()
{
  TestSpr = DynamicSprite.Create(Room.Width, Room.Height);
  
  DrawingSurface *ds = TestSpr.GetDrawingSurface();
  int color16 = 500;
  for (int x = 0; x < Room.Width; x += 32)
  {
    for (int y = 0; y < Room.Height; y += 20)
    {
      ds.DrawingColor = color16;
      ds.DrawRectangle(x, y, x + 32, y + 20);
      color16 += 500;
    }
  }
  ds.Release();
  
  ds = Room.GetDrawingSurfaceForBackground();
  ds.DrawImage(0, 0, TestSpr.Graphic);
  ds.Release();
}

void CleanupRoom()
{
  TestSpr.Delete();
  TestSpr = null;
  
  DrawingSurface *ds = Room.GetDrawingSurfaceForBackground();
  ds.Clear(0);
  ds.Release();
  
  Game.Camera.SetSize(Room.Width, Room.Height);
  Game.Camera.SetAt(0, 0);
  Screen.Viewport.SetPosition(0, 0, Screen.Width, Screen.Height);
}

void TestCameraPosition(int camx, int camy, int camw, int camh, int viewx, int viewy, int vieww, int viewh, 
  String test_name)
{
  // Set camera size prior to pos, as its pos may be clamped to the room if size is big
  Game.Camera.SetSize(camw, camh);
  Game.Camera.SetAt(camx, camy);
  Screen.Viewport.SetPosition(viewx, viewy, vieww, viewh);
  Wait(1); // let engine redraw game
  
  DynamicSprite *camera_cut = DynamicSprite.Create(vieww, viewh);
  DrawingSurface *ds = camera_cut.GetDrawingSurface();
  ds.DrawImage(0, 0, TestSpr.Graphic, 0, vieww, viewh, camx, camy, camw, camh);
  ds.Release();
  
  int cropx, cropy;
  if (viewx < 0)
  {
    cropx = -viewx;
    vieww = vieww - cropx;
    viewx = 0;
  }
  if (viewy < 0)
  {
    cropy -= viewy;
    viewh = viewh - cropy;
    viewy = 0;
  }
  if ((viewx + vieww - 1) >= Screen.Width)
  {
    vieww = Screen.Width - viewx;
  }
  if ((viewy + viewh - 1) >= Screen.Height)
  {
    viewh = Screen.Height - viewy;
  }

  camera_cut.Crop(cropx, cropy, vieww, viewh);
  
  tap.ok(GfxComparer.TakeScreenshotAndMatchSprite(viewx, viewy, vieww, viewh, camera_cut.Graphic),
    test_name);
}

void TestCameraRenderAtDifferentPositions(int camw, int camh, int vieww, int viewh, String test_name)
{
  // camera positions around the room
  TestCameraPosition(Room.Width / 4, 0, camw, camh, 0, 0, vieww, viewh, 
    String.Format("%s, camera pos at x 1/4", test_name));
  TestCameraPosition(Room.Width / 2, 0, camw, camh, 0, 0, vieww, viewh, 
    String.Format("%s, camera pos at x 1/2", test_name));
  TestCameraPosition(0, Room.Height / 4, camw, camh, 0, 0, vieww, viewh, 
    String.Format("%s, camera pos at y 1/4", test_name));
  TestCameraPosition(0, Room.Height / 2, camw, camh, 0, 0, vieww, viewh, 
    String.Format("%s, camera pos at y 1/2", test_name));
  TestCameraPosition(Room.Width / 4, Room.Height / 4, camw, camh, 0, 0, vieww, viewh, 
    String.Format("%s, camera pos at x,y 1/4", test_name));
  TestCameraPosition(Room.Width / 2, Room.Height / 2, camw, camh, 0, 0, vieww, viewh, 
    String.Format("%s, camera pos at x,y 1/2", test_name));
    
  // viewport positions around the screen
  TestCameraPosition(0, 0, Room.Width / 2, Room.Height / 2, Room.Width / 4, 0, vieww, viewh, 
    String.Format("%s, viewport pos at x 1/4", test_name));
  TestCameraPosition(0, 0, Room.Width / 2, camw, camh, 0, vieww, viewh, 
    String.Format("%s, viewport pos at x 1/2", test_name));
  TestCameraPosition(0, 0, camw, camh, 0, Room.Height / 4, vieww, viewh, 
    String.Format("%s, viewport pos at y 1/4", test_name));
  TestCameraPosition(0, 0, camw, camh, 0, Room.Height / 2, vieww, viewh, 
    String.Format("%s, viewport pos at y 1/2", test_name));
  TestCameraPosition(0, 0, camw, camh, Room.Width / 4, Room.Height / 4, vieww, viewh, 
    String.Format("%s, viewport pos at x,y 1/4", test_name));
  TestCameraPosition(0, 0, camw, camh, Room.Width / 2, Room.Height / 2, vieww, viewh, 
    String.Format("%s, viewport pos at x,y 1/2", test_name));
    
  // camera and viewport move together
  TestCameraPosition(Room.Width / 4, 0, camw, camh, Room.Width / 4, 0, vieww, viewh, 
    String.Format("%s, camera pos at x 1/4, viewport pos at x 1/4", test_name));
  TestCameraPosition(Room.Width / 2, 0, camw, camh, Room.Width / 2, 0, vieww, viewh, 
    String.Format("%s, camera pos at x 1/2, viewport pos at x 1/2", test_name));
  TestCameraPosition(0, Room.Height / 4, camw, camh, 0, Room.Height / 4, vieww, viewh, 
    String.Format("%s, camera pos at y 1/4, viewport pos at y 1/4", test_name));
  TestCameraPosition(0, Room.Height / 2, camw, camh, 0, Room.Height / 2, vieww, viewh, 
    String.Format("%s, camera pos at y 1/2, viewport pos at y 1/2", test_name));
  TestCameraPosition(Room.Width / 4, Room.Height / 4, camw, camh, Room.Width / 4, Room.Height / 4, vieww, viewh, 
    String.Format("%s, camera pos at x,y 1/4, viewport pos at x,y 1/4", test_name));
  TestCameraPosition(Room.Width / 2, Room.Height / 2, camw, camh, Room.Width / 2, Room.Height / 2, vieww, viewh, 
    String.Format("%s, camera pos at x,y 1/2, viewport pos at x,y 1/2", test_name));
}

void TestCameraRender()
{
  // default positions and sizes
  TestCameraPosition(0, 0, Room.Width, Room.Height, 0, 0, Room.Width, Room.Height, 
    "Camera: Camera & Viewport default position");
  
  // non-default sizes, equal
  TestCameraPosition(0, 0, Room.Width / 2, Room.Height / 2, 0, 0, Room.Width / 2, Room.Height / 2, 
    "Camera: Camera & Viewport equal size 1/2 of room");
  TestCameraPosition(0, 0, Room.Width * 3 / 4, Room.Height * 3 / 4, 0, 0, Room.Width * 3 / 4, Room.Height * 3 / 4, 
    "Camera: Camera & Viewport equal size 3/4 of room");
    
  // viewport larger, zoom in effect
  TestCameraPosition(0, 0, Room.Width / 2, Room.Height / 2, 0, 0, Room.Width, Room.Height, 
    "Camera: Viewport larger than Camera, scale from 1/2 of room");
  TestCameraPosition(0, 0, Room.Width * 3 / 4, Room.Height * 3 / 4, 0, 0, Room.Width, Room.Height, 
    "Camera: Viewport larger than Camera, scale from 3/4 of room");
  
  // viewport smaller, zoom out effect
  TestCameraPosition(0, 0, Room.Width, Room.Height, 0, 0, Room.Width / 2, Room.Height / 2, 
    "Camera: Viewport smaller than Camera, scale down to 1/2 of screen");
  TestCameraPosition(0, 0, Room.Width, Room.Height, 0, 0, Room.Width * 3 / 4, Room.Height * 3 / 4, 
    "Camera: Viewport smaller than Camera, scale down to 3/4 of room");
    
  // run positions tests with no scaling
  TestCameraRenderAtDifferentPositions(Room.Width / 2, Room.Height / 2, Room.Width / 2, Room.Height / 2, 
    "Camera: Camera & Viewport equal size 1/2 of room");
  
  // run positions tests with zoom in effect
  TestCameraRenderAtDifferentPositions(Room.Width / 4, Room.Height / 4, Room.Width / 2, Room.Height / 2, 
    "Camera: Viewport larger than Camera");
    
  // run positions tests with zoom out effect
  TestCameraRenderAtDifferentPositions(Room.Width / 2, Room.Height / 2, Room.Width / 4, Room.Height / 4, 
    "Camera: Viewport smaller than Camera");
    
  // viewport partially offscren
  TestCameraPosition(0, 0, Room.Width, Room.Height, -Room.Width / 2, 0, Room.Width, Room.Height, 
    "Camera: Camera & Viewport equal size, viewport pos offscreen x -1/2");
  TestCameraPosition(0, 0, Room.Width, Room.Height, Room.Width / 2, 0, Room.Width, Room.Height, 
    "Camera: Camera & Viewport equal size, viewport pos offscreen x +1/2");
  TestCameraPosition(0, 0, Room.Width, Room.Height, 0, -Room.Height / 2, Room.Width, Room.Height, 
    "Camera: Camera & Viewport equal size, viewport pos offscreen y -1/2");
  TestCameraPosition(0, 0, Room.Width, Room.Height, 0, Room.Height / 2, Room.Width, Room.Height, 
    "Camera: Camera & Viewport equal size, viewport pos offscreen y +1/2");
}

//-----------------------------------------------------------------------------
// MAIN
//-----------------------------------------------------------------------------

void TestCamera()
{
  tap.Comment("start Camera tests");
  int old_game_speed = GetGameSpeed();
  SetGameSpeed(1000);
  
  // Disable characters and objects, avoid interfering with our tests
  TestHelpers.HideGUIs();
  TestHelpers.HideRoomObjects();
  
  PrepareRoom();
  TestCameraRender();
  CleanupRoom();
  
  SetGameSpeed(old_game_speed);
  tap.Comment("end Camera tests");
}
