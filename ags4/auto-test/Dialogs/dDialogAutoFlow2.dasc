// Dialog script file
@S  // Dialog startup entry point
return
@1
  DialogFlowTestStep++;
  tap.is_int(DialogFlowTestStep, 2, "Dialog Auto Flow: step 2");
option-off 1
option-on 2
goto-previous
@2
  DialogFlowTestStep++;
  tap.is_int(DialogFlowTestStep, 4, "Dialog Auto Flow: step 4");
option-off 2
option-on 3
  return RUN_DIALOG_GOTO_PREVIOUS;
@3
  DialogFlowTestStep++;
  tap.is_int(DialogFlowTestStep, 6, "Dialog Auto Flow: step 6");
option-off 3
option-on 4
  dDialogAutoFlow2.Start();
return
@4
  DialogFlowTestStep++;
  tap.is_int(DialogFlowTestStep, 7, "Dialog Auto Flow: step 7");
option-off 4
option-on 5
  return 3;
@5
stop
